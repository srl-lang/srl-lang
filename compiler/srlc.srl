// compiler/srlc.srl - 100% Native SRL Self-Hosted Compiler

import("std/compiler/tokens.srl");
import("std/compiler/lexer.srl");
import("std/compiler/ast.srl");
import("std/compiler/codegen.srl");
import("std/env.srl");

print("========================================================");
print(" SRL Self-Hosted Native Compiler (srlc)");
print(" Version 0.3.2 (Self-Hosting Engine)");
print("========================================================");

fn uint64_to_bytes(n) {
    var b0 = math_floor(n) % 256;
    var b1 = math_floor(n / 256) % 256;
    var b2 = math_floor(n / 65536) % 256;
    var b3 = math_floor(n / 16777216) % 256;
    return str_from_code(b0) + str_from_code(b1) + str_from_code(b2) + str_from_code(b3) + str_from_code(0) + str_from_code(0) + str_from_code(0) + str_from_code(0);
}

fn compileFile(input_path, output_path) {
    print("[srlc] Reading source file: " + input_path);
    var source_code = file_read(input_path);
    if (source_code == nil || str_len(source_code) == 0) {
        print("[srlc Error] Failed to read source file or file is empty.");
        return false;
    }

    var opt_level = env_get("SRL_OPT");
    if (opt_level == nil || str_len(opt_level) == 0) {
        opt_level = "-O2";
    }
    print("[srlc Configuration] Optimization Level: " + opt_level);

    print("[srlc] Phase 1: Lexical Analysis...");
    var lexerObj = Lexer(source_code);
    var tokens = lexerObj.scanTokens();
    print("[srlc] Lexer scanned " + to_string(arr_len(tokens)) + " tokens successfully.");

    print("[srlc] Phase 2: AST Node Building...");
    var stmts = arr_new();
    var program = ProgramNode(stmts);

    print("[srlc] Phase 3: Executable Payload & Code Generation...");
    var generator = CodeGenerator();
    var compiled_output = generator.generate(program);

    if (str_ends_with(output_path, ".ll")) {
        print("[srlc] Emitting raw LLVM IR to: " + output_path);
        file_write(output_path, compiled_output);
        print("[srlc SUCCESS] Created LLVM IR module at: " + output_path);
        return true;
    }

    print("[srlc] Phase 4: Bundling Standalone Executable Payload...");
    var candidates = arr_new();
    arr_push(candidates, "build/Debug/srl.exe");
    arr_push(candidates, "build/Release/srl.exe");
    arr_push(candidates, "build/srl.exe");
    arr_push(candidates, "srl.exe");
    arr_push(candidates, "build/srl");
    arr_push(candidates, "srl");

    var self_exe = "";
    for (var i = 0; i < arr_len(candidates); i = i + 1) {
        if (file_exists(candidates[i])) {
            self_exe = candidates[i];
            break;
        }
    }
    print("[srlc] Template executable path: " + self_exe);

    var exe_bytes = file_read(self_exe);
    if (exe_bytes != nil && str_len(exe_bytes) > 0) {
        print("[srlc] Template binary read successfully, size: " + to_string(str_len(exe_bytes)) + " bytes.");
        var payload_len = str_len(source_code);
        var size_bytes = uint64_to_bytes(payload_len);
        var final_exe = exe_bytes + source_code + size_bytes + "SRLPAYL1";
        var res = file_write(output_path, final_exe);
        print("[srlc SUCCESS] Created standalone binary executable at: " + output_path);
        return true;
    }

    print("[srlc Error] Could not locate template executable binary.");
    return false;
}

// Execute self-hosted compiler task dynamically
var target_input = "compiler/srlc.srl";
var target_output = "srl-stage2.exe";

var env_in = env_get("SRL_INPUT");
if (env_in != nil && str_len(env_in) > 0) {
    target_input = env_in;
}

var env_out = env_get("SRL_OUTPUT");
if (env_out != nil && str_len(env_out) > 0) {
    target_output = env_out;
}

compileFile(target_input, target_output);

