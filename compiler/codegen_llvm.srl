// ============================================================================
// SRL Self-Hosted Compiler - LLVM IR Code Generator (compiler/codegen_llvm.srl)
// ============================================================================

fn codegen_stmt_list(stmts, label_prefix) {
    var ir = "";
    var count = arr_len(stmts);
    var i = 0;
    while i < count {
        var stmt = arr_get(stmts, i);
        var type_name = map_get(stmt, "type");

        if type_name == "EXPR_STMT" {
            var expr = map_get(stmt, "expr");
            if expr != nil {
                var expr_type = map_get(expr, "type");
                if expr_type == "CALL" {
                    var callee = map_get(expr, "callee");
                    var args = map_get(expr, "args");
                    if callee == "print" && arr_len(args) > 0 {
                        var first_arg = arr_get(args, 0);
                        var val_type = map_get(first_arg, "val_type");
                        var val = map_get(first_arg, "value");
                        var arg_type = map_get(first_arg, "type");

                        if val_type == "NUMBER" {
                            ir = ir + "  call void @srl_print_num(double " + to_string(val) + ")\n";
                        } else if val_type == "STRING" {
                            ir = ir + "  ; print string: \"" + to_string(val) + "\"\n";
                        } else if arg_type == "GET_FIELD" {
                            var obj = map_get(first_arg, "object");
                            var field = map_get(first_arg, "field");
                            ir = ir + "  ; print field access: " + to_string(map_get(obj, "name")) + "." + to_string(field) + "\n";
                        } else if arg_type == "VARIABLE" {
                            ir = ir + "  ; print variable: " + to_string(map_get(first_arg, "name")) + "\n";
                        } else {
                            ir = ir + "  ; print expression\n";
                        }
                    }
                }
            }
        } else if type_name == "VAR_DECL" {
            var var_name = map_get(stmt, "name");
            ir = ir + "  %" + var_name + " = alloca double, align 8\n";
            var init_expr = map_get(stmt, "initializer");
            if init_expr != nil && map_get(init_expr, "type") == "LITERAL" {
                var init_val = map_get(init_expr, "value");
                ir = ir + "  store double " + to_string(init_val) + ", double* %" + var_name + ", align 8\n";
            }
        } else if type_name == "STRUCT_DECL" {
            var struct_name = map_get(stmt, "name");
            ir = ir + "  ; struct declaration: " + struct_name + "\n";
        } else if type_name == "FOR_STMT" {
            ir = ir + "  ; --- Begin For Loop ---\n";
            var init_stmt = map_get(stmt, "initializer");
            if init_stmt != nil {
                var init_arr = arr_new();
                arr_push(init_arr, init_stmt);
                ir = ir + codegen_stmt_list(init_arr, label_prefix + "_for_init");
            }
            var body_stmts = map_get(stmt, "body");
            if body_stmts != nil {
                ir = ir + codegen_stmt_list(body_stmts, label_prefix + "_for_body");
            }
            ir = ir + "  ; --- End For Loop ---\n";
        } else if type_name == "FOR_IN_STMT" {
            ir = ir + "  ; --- Begin For-In Loop ---\n";
            var fibody_stmts = map_get(stmt, "body");
            if fibody_stmts != nil {
                ir = ir + codegen_stmt_list(fibody_stmts, label_prefix + "_for_in_body");
            }
            ir = ir + "  ; --- End For-In Loop ---\n";
        } else if type_name == "IF_STMT" {
            ir = ir + "  ; --- Begin If Statement ---\n";
            var then_stmts = map_get(stmt, "then_branch");
            if then_stmts != nil {
                ir = ir + codegen_stmt_list(then_stmts, label_prefix + "_if_then");
            }
            var else_stmts = map_get(stmt, "else_branch");
            if else_stmts != nil {
                ir = ir + codegen_stmt_list(else_stmts, label_prefix + "_if_else");
            }
            ir = ir + "  ; --- End If Statement ---\n";
        } else if type_name == "WHILE_STMT" {
            ir = ir + "  ; --- Begin While Loop ---\n";
            var wbody_stmts = map_get(stmt, "body");
            if wbody_stmts != nil {
                ir = ir + codegen_stmt_list(wbody_stmts, label_prefix + "_while_body");
            }
            ir = ir + "  ; --- End While Loop ---\n";
        } else if type_name == "TRY_CATCH_STMT" {
            ir = ir + "  ; --- Begin Try-Catch Block ---\n";
            var try_stmts = map_get(stmt, "try_body");
            if try_stmts != nil {
                ir = ir + codegen_stmt_list(try_stmts, label_prefix + "_try");
            }
            var catch_stmts = map_get(stmt, "catch_body");
            if catch_stmts != nil {
                ir = ir + codegen_stmt_list(catch_stmts, label_prefix + "_catch");
            }
            ir = ir + "  ; --- End Try-Catch Block ---\n";
        } else if type_name == "THROW_STMT" {
            ir = ir + "  ; --- Exception Throw Statement ---\n";
            ir = ir + "  call void @exit(i32 1)\n";
        } else if type_name == "UNION_DECL" {
            var union_name = map_get(stmt, "name");
            ir = ir + "  ; union memory overlay declaration: " + union_name + "\n";
        } else if type_name == "TEMPLATE_DECL" {
            var tmpl_name = map_get(stmt, "name");
            ir = ir + "  ; generic template declaration: " + tmpl_name + "\n";
        }

        i = i + 1;
    }
    return ir;
}

fn codegen_generate_llvm(ast_statements) {
    var ir = "; ModuleID = 'srl_self_hosted_module'\n";
    ir = ir + "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128\"\n";
    ir = ir + "target triple = \"x86_64-pc-windows-msvc\"\n\n";

    // Standard C Runtime External Declarations
    ir = ir + "declare i32 @printf(i8*, ...)\n";
    ir = ir + "declare i8* @malloc(i64)\n";
    ir = ir + "declare void @free(i8*)\n";
    ir = ir + "declare void @exit(i32)\n\n";

    // String constants pool
    ir = ir + "@.str.fmt_num = private unnamed_addr constant [4 x i8] c\"%g\\0A\\00\", align 1\n";
    ir = ir + "@.str.fmt_str = private unnamed_addr constant [4 x i8] c\"%s\\0A\\00\", align 1\n\n";

    // Standard SRL Native Print Wrapper
    ir = ir + "define void @srl_print_num(double %val) {\n";
    ir = ir + "  %fmt = getelementptr inbounds [4 x i8], [4 x i8]* @.str.fmt_num, i64 0, i64 0\n";
    ir = ir + "  call i32 (i8*, ...) @printf(i8* %fmt, double %val)\n";
    ir = ir + "  ret void\n";
    ir = ir + "}\n\n";

    ir = ir + "define void @srl_print_str(i8* %str) {\n";
    ir = ir + "  %fmt = getelementptr inbounds [4 x i8], [4 x i8]* @.str.fmt_str, i64 0, i64 0\n";
    ir = ir + "  call i32 (i8*, ...) @printf(i8* %fmt, i8* %str)\n";
    ir = ir + "  ret void\n";
    ir = ir + "}\n\n";

    // Main Entry Function
    ir = ir + "define i32 @main() {\n";
    ir = ir + "entry:\n";

    ir = ir + codegen_stmt_list(ast_statements, "main");

    ir = ir + "  ret i32 0\n";
    ir = ir + "}\n";

    return ir;
}
