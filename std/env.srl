// ============================================================================
// SRL Standard Library - System & Environment Utilities (std/env.srl)
// ============================================================================

fn env_get(var_name) {
    return sys_env_get(var_name);
}


fn env_os() {
    return sys_os();
}

fn env_pwd() {
    return sys_pwd();
}

fn env_files(dir_path) {
    return sys_list_dir(dir_path);
}
