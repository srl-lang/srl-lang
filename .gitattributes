# Exclude infrastructure, runtime, and shell scripts from language stats
src/** linguist-vendored=true
include/** linguist-vendored=true
srlc/** linguist-vendored=true
build/** linguist-vendored=true
CMakeLists.txt linguist-vendored=true

# Exclude batch and shell wrapper scripts
*.bat linguist-vendored=true
*.sh linguist-vendored=true
*.vcxproj linguist-vendored=true
*.filters linguist-vendored=true

# SRL language configuration
*.srl linguist-language=SRL
*.srl linguist-detectable=true
*.srl linguist-syntax=cpp
