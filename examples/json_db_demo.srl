// SRL Language - JSON, Database & Cryptography Demo (examples/json_db_demo.srl)

print("=================================================");
print("     SRL JSON, DATABASE & CRYPTOGRAPHY DEMO      ");
print("=================================================");

// 1. JSON Parsing & Stringifying
print("\n--- 1. JSON Engine (`json_*`) ---");
var raw_json = "{\"player\": \"Alice\", \"score\": 2500, \"active\": true, \"data\": [10, 20, 30]}";
print("Raw JSON: " + raw_json);

var parsed = json_parse(raw_json);
print("Parsed player: " + map_get(parsed, "player"));
print("Parsed score: " + to_string(map_get(parsed, "score")));

var new_json = json_stringify(parsed);
print("Re-serialized JSON: " + new_json);

// 2. Local File Key-Value Database
print("\n--- 2. Local Database Engine (`db_*`) ---");
var db = db_open("user_settings.srl_db");
db_set(db, "theme", "dark");
db_set(db, "volume", "95");
db_set(db, "last_session", "2026-07-26");

print("DB Read Theme: " + db_get(db, "theme"));
print("DB Read Volume: " + db_get(db, "volume") + "%");
db_close(db);
print("Database saved and closed successfully.");

// 3. Cryptography & Hashing
print("\n--- 3. Cryptography & Hash (`crypto_*`) ---");
var text = "SRL Programming Language 2026";
var b64_enc = crypto_base64_encode(text);
print("Original: " + text);
print("Base64 Encode: " + b64_enc);
print("Base64 Decode: " + crypto_base64_decode(b64_enc));
print("SHA-256 Hash: " + crypto_sha256(text));
print("MD5 Hash: " + crypto_md5(text));

print("\n=== ALL MAJOR LIBRARIES RAN SUCCESSFULLY ===");
