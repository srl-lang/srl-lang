// SRL Language - Network & HTTP Client Demo (examples/net_demo.srl)
import("std/net.srl");

print("=================================================");
print("       SRL NETWORK (NET) & HTTP CLIENT DEMO      ");
print("=================================================");

print("\n[1] Sending HTTP GET Request (httpbin.org/ip)...");
var resp = net_http_get("httpbin.org", "/ip");

if str_len(resp) > 0 {
    print("[Success] HTTP Response received:\n");
    print(str_sub(resp, 0, 300));
} else {
    print("[Info] No HTTP response received or server connection is closed.");
}

print("\n=== NETWORK TEST COMPLETED ===");
