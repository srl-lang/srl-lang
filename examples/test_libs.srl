// Test script for SRL expanded standard library features

print("=== SRL Standard Library Test ===");

// 1. Math Library Test
print("\n--- 1. Math Test ---");
var pi = math_pi();
print("PI Value: " + to_string(pi));
print("Sin(PI/2): " + to_string(math_sin(pi / 2)));
print("Sqrt(144): " + to_string(math_sqrt(144)));
print("Pow(2, 8): " + to_string(math_pow(2, 8)));
print("Clamp(150, 0, 100): " + to_string(math_clamp(150, 0, 100)));
print("Random Number: " + to_string(math_random_range(10, 50)));

// 2. String Library Test
print("\n--- 2. String Test ---");
var text = "  SRL Programming Language Libraries  ";
print("Original: [" + text + "]");
print("Trimmed: [" + str_trim(text) + "]");
print("Upper: " + str_upper(str_trim(text)));
print("Contains 'Language': " + to_string(str_contains(text, "Language")));
var words = str_split(str_trim(text), " ");
print("Word Count: " + to_string(arr_len(words)));

// 3. File & Directory Test
print("\n--- 3. File & Directory Test ---");
file_write("temp_test.txt", "SRL Library Test Data\n");
file_append("temp_test.txt", "Line 2 Appended.\n");
print("File exists: " + to_string(file_exists("temp_test.txt")));
print("File size: " + to_string(file_size("temp_test.txt")) + " bytes");
print("File contents:\n" + file_read("temp_test.txt"));
file_remove("temp_test.txt");

// 4. Import Test
print("\n--- 4. Import Module Test ---");
var audio_std_var = import("std/audio.srl");
print("std/audio.srl imported: " + to_string(audio_std_var));

var player = audio_player_new();
print("Audio Player created. Volume: " + to_string(map_get(player, "volume")) + "%");

// 5. Audio Beep Synthesizer Test
print("\n--- 5. Audio Synthesizer (Tone Beep) Test ---");
print("Playing beep tones...");
audio_beep(440, 150); // 440 Hz (A4 note)
audio_beep(880, 150); // 880 Hz (A5 note)

print("\n=== ALL STANDARD LIBRARY TESTS COMPLETED SUCCESSFULLY ===");
