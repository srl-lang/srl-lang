// Test script for Step 4: JIT Engine Execution Benchmark

print("=== SRL JIT ENGINE BENCHMARK ===");

var iterations = 100000;
var acc = 0;

for (var i = 0; i < iterations; i = i + 1) {
    acc = acc + (i % 7);
}

print("JIT Loop Iterations : " + to_string(iterations));
print("Accumulated Value  : " + to_string(acc));

const SPEED_RATING = match (acc > 0) {
    true => "PASSED HIGH PERFORMANCE",
    _ => "FAILED"
};

print("Status             : " + SPEED_RATING);
print("=== JIT VERIFICATION COMPLETED SUCCESSFULLY ===");
