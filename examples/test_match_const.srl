// Test script for Step 1: const variables and match pattern matching

print("=== CONST VARIABLE TEST ===");
const MAX_LIMIT = 100;
const APP_NAME = "SRL Language";

print("MAX_LIMIT = " + to_string(MAX_LIMIT));
print("APP_NAME = " + APP_NAME);

print("\n=== PATTERN MATCHING TEST ===");
fn get_status_code(code) {
    return match (code) {
        200 => "OK",
        404 => "Not Found",
        500 => "Internal Server Error",
        _ => "Unknown Status"
    };
}

print("Code 200: " + get_status_code(200));
print("Code 404: " + get_status_code(404));
print("Code 500: " + get_status_code(500));
print("Code 999: " + get_status_code(999));

print("\n=== STRING MATCH TEST ===");
var action = "start";
var action_text = match (action) {
    "start" => "System Initialized",
    "stop" => "System Halted",
    _ => "No Action"
};
print("Action 'start' => " + action_text);

print("\n=== STEP 1 VERIFICATION COMPLETED SUCCESSFULLY ===");
