// SRL Language - Interactive Music Player & Spectrum Visualizer Application (examples/music_player.srl)
import("std/audio.srl");
import("std/ui.srl");

print("=================================================");
print("     SRL MUSIC PLAYER & SPECTRUM VISUALIZER      ");
print("=================================================");

var active_file = "";
var is_playing = false;
var is_paused = false;
var volume = 80;

// Open Windows File Selection Dialog
print("\n[1/3] Please select an MP3 or WAV audio file...");
active_file = gui_file_dialog_open("SRL Music Player - Select Audio File", "*.mp3;*.wav|All Files (*.*)|*.*");

if str_len(active_file) == 0 {
    print("[Info] No file selected. Switching to internal DSP signal mode.");
    gui_msgbox("SRL Music Player", "No file selected. Starting with internal DSP synthesizer.", "info");
} else {
    print("[Success] Selected File: " + active_file);
    gui_msgbox("SRL Music Player", "Loaded File: " + active_file, "info");
}

fn display_menu() {
    tui_clear();
    tui_color("cyan");
    tui_box(1, 1, 76, 17, "SRL MUSIC PLAYER (Serial Run Language Engine)");

    tui_move(3, 4);
    tui_color("yellow");
    if str_len(active_file) > 0 {
        print("Current Track: " + active_file);
    } else {
        print("Current Track: [Internal Signal Synthesizer]");
    }

    tui_move(5, 4);
    tui_color("white");
    print("[1] Select File (Win32 File Dialog)");
    tui_move(6, 4);
    print("[2] Play");
    tui_move(7, 4);
    print("[3] Pause / Resume");
    tui_move(8, 4);
    print("[4] Stop");
    tui_move(9, 4);
    print("[5] Volume Up (+10)");
    tui_move(10, 4);
    print("[6] Volume Down (-10)");
    tui_move(11, 4);
    print("[7] Live FFT Spectrum & Waveform (DSP Engine)");
    tui_move(12, 4);
    print("[8] Play Synthesizer Beep Tone");
    tui_move(13, 4);
    print("[0] Exit");

    tui_move(15, 4);
    tui_color("green");
    var pos = audio_get_position();
    var len = audio_get_length();
    var status_str = "Status: ";
    if audio_is_playing() {
        status_str = status_str + "Playing";
    } else {
        status_str = status_str + "Stopped";
    }
    print(status_str + " | Volume: " + to_string(volume) + "% | Time: " + ui_format_time(pos) + " / " + ui_format_time(len));
    tui_reset();
}

var running = true;

while running {
    display_menu();
    tui_move(19, 1);
    tui_color("cyan");
    print("Your choice [0-8]: ");
    tui_reset();

    var key = tui_get_key();
    if str_len(key) == 0 {
        sleep_ms(100);
    } else {
        if key == "1" {
            var selected = gui_file_dialog_open("Select Audio File", "*.mp3;*.wav");
            if str_len(selected) > 0 {
                active_file = selected;
                audio_play(active_file);
                audio_set_volume(volume);
                is_playing = true;
            }
        } else if key == "2" {
            if str_len(active_file) > 0 {
                audio_play(active_file);
                audio_set_volume(volume);
                is_playing = true;
            } else {
                print("Please select a file first!");
                sleep_ms(1000);
            }
        } else if key == "3" {
            if is_paused {
                audio_resume();
                is_paused = false;
            } else {
                audio_pause();
                is_paused = true;
            }
        } else if key == "4" {
            audio_stop();
            is_playing = false;
            is_paused = false;
        } else if key == "5" {
            volume = math_clamp(volume + 10, 0, 100);
            audio_set_volume(volume);
        } else if key == "6" {
            volume = math_clamp(volume - 10, 0, 100);
            audio_set_volume(volume);
        } else if key == "7" {
            tui_clear();
            print("=== SRL DSP & FFT Live Spectrum Visualizer ===");
            var signal = dsp_sine(440, 8000, 64);
            dsp_plot(signal, 8, "440 Hz Sine Waveform");
            var fft_res = dsp_fft(signal);
            var mag = dsp_magnitude(map_get(fft_res, "real"), map_get(fft_res, "imag"));
            dsp_plot(mag, 8, "FFT Frequency Spectrum");
            print("\nPress any key to continue...");
            sleep_ms(2500);
        } else if key == "8" {
            audio_beep(523, 150); // C5
            audio_beep(659, 150); // E5
            audio_beep(784, 200); // G5
        } else if key == "0" {
            audio_stop();
            tui_clear();
            print("SRL Music Player closed. Goodbye!");
            running = false;
        }
    }
}
