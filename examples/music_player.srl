// SRL Language - Interactive Music Player & Spectrum Visualizer Application (examples/music_player.srl)
import("std/audio.srl");
import("std/ui.srl");

print("=================================================");
print("     SRL MUZIK CALAR & SPEKTRUM GORSELLESTIRICI    ");
print("=================================================");

var active_file = "";
var is_playing = false;
var is_paused = false;
var volume = 80;

// Windows Dosya Seçim Diyaloğunu Başlat
print("\n[1/3] Lutfen bir MP3 veya WAV ses dosyasi secin...");
active_file = gui_file_dialog_open("SRL Muzik Calar - Ses Dosyasi Secin", "*.mp3;*.wav|Tüm Dosyalar (*.*)|*.*");

if str_len(active_file) == 0 {
    print("[Bilgi] Dosya secilmedi. Varsayilan DSP sinyal moduna geciliyor.");
    gui_msgbox("SRL Muzik Calar", "Dosya secilmedigi icin dahili DSP sentezleyici ile baslatiliyor.", "info");
} else {
    print("[Basarili] Secilen Dosya: " + active_file);
    gui_msgbox("SRL Muzik Calar", "Yuklenen Dosya: " + active_file, "info");
}

fn display_menu() {
    tui_clear();
    tui_color("cyan");
    tui_box(1, 1, 76, 17, "SRL MUZIK CALAR (Serial Run Language Engine)");
    
    tui_move(3, 4);
    tui_color("yellow");
    if str_len(active_file) > 0 {
        print("Mevcut Parca: " + active_file);
    } else {
        print("Mevcut Parca: [Dahili Sinyal Sentezleyici]");
    }

    tui_move(5, 4);
    tui_color("white");
    print("[1] Dosya Sec (Win32 File Dialog)");
    tui_move(6, 4);
    print("[2] Oynat (Play)");
    tui_move(7, 4);
    print("[3] Duraklat / Devam Et (Pause / Resume)");
    tui_move(8, 4);
    print("[4] Durdur (Stop)");
    tui_move(9, 4);
    print("[5] Ses Yukselt (+10)");
    tui_move(10, 4);
    print("[6] Ses Azalt (-10)");
    tui_move(11, 4);
    print("[7] Canli FFT Spektrum & Waveform Ciz (DSP Engine)");
    tui_move(12, 4);
    print("[8] Synthesizer Beep Tonu Cal");
    tui_move(13, 4);
    print("[0] Cikis");

    tui_move(15, 4);
    tui_color("green");
    var pos = audio_get_position();
    var len = audio_get_length();
    var status_str = "Durum: ";
    if audio_is_playing() {
        status_str = status_str + "Oynatiliyor (PLAYING)";
    } else {
        status_str = status_str + "Durduruldu (STOPPED)";
    }
    print(status_str + " | Ses: %" + to_string(volume) + " | Sure: " + ui_format_time(pos) + " / " + ui_format_time(len));
    tui_reset();
}

var running = true;

while running {
    display_menu();
    tui_move(19, 1);
    tui_color("cyan");
    print("Seciminiz [0-8]: ");
    tui_reset();

    var key = tui_get_key();
    if str_len(key) == 0 {
        sleep_ms(100);
    } else {
        if key == "1" {
            var selected = gui_file_dialog_open("Ses Dosyasi Sec", "*.mp3;*.wav");
            if str_len(selected) > 0 {
                active_file = selected;
                audio_play(active_file);
                audio_set_volume(volume);
                is_playing = true;
            }
        } else if key == "2" {
            if str_len(active_file) > 0 {
                audio_play(active_file);
                audio_set_volume(volume);
                is_playing = true;
            } else {
                print("Lutfen once bir dosya secin!");
                sleep_ms(1000);
            }
        } else if key == "3" {
            if is_paused {
                audio_resume();
                is_paused = false;
            } else {
                audio_pause();
                is_paused = true;
            }
        } else if key == "4" {
            audio_stop();
            is_playing = false;
            is_paused = false;
        } else if key == "5" {
            volume = math_clamp(volume + 10, 0, 100);
            audio_set_volume(volume);
        } else if key == "6" {
            volume = math_clamp(volume - 10, 0, 100);
            audio_set_volume(volume);
        } else if key == "7" {
            tui_clear();
            print("=== SRL DSP & FFT Canli Spektrum Görsellestirici ===");
            var signal = dsp_sine(440, 8000, 64);
            dsp_plot(signal, 8, "440 Hz Sinus Dalga Sekli (Waveform)");
            var fft_res = dsp_fft(signal);
            var mag = dsp_magnitude(map_get(fft_res, "real"), map_get(fft_res, "imag"));
            dsp_plot(mag, 8, "FFT Frekans Spektrumu (Frequency Spectrum)");
            print("\nDevam etmek icin bir tusa basin...");
            sleep_ms(2500);
        } else if key == "8" {
            audio_beep(523, 150); // C5
            audio_beep(659, 150); // E5
            audio_beep(784, 200); // G5
        } else if key == "0" {
            audio_stop();
            tui_clear();
            print("SRL Muzik Calar kapatildi. Iyi gunler!");
            running = false;
        }
    }
}
