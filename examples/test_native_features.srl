// Test script for SRL full native system capabilities (FFI, SYS, Threading, GFX, NET)

print("=== SRL NATIVE SYSTEM CAPABILITIES TEST ===");

// 1. System Diagnostics & Process Test
print("\n--- 1. System & Diagnostics Test (`sys_*`) ---");
print("CPU Core Count: " + to_string(sys_cpu_count()));
print("Process PID: " + to_string(sys_pid()));
print("Memory Usage: " + to_string(sys_memory_usage()) + " bytes");
print("PATH env var exists: " + to_string(str_len(sys_env_get("PATH")) > 0));

// 2. FFI (Foreign Function Interface) Test
print("\n--- 2. FFI Engine (`ffi_*`) ---");
var user32_dll = ffi_load("user32.dll");
print("user32.dll loaded (Handle ID): " + to_string(user32_dll));

if user32_dll > 0 {
    ffi_free(user32_dll);
    print("user32.dll released.");
}

// 3. Threading / Async Background Test
print("\n--- 3. Multithreading (`thread_*`) ---");
fn background_task() {
    print("  [Background Thread] Async task started!");
    sleep_ms(100);
    print("  [Background Thread] Async task completed!");
}

var tid = thread_create("background_task");
print("Thread started (Thread ID): " + to_string(tid));
thread_join(tid);
print("Thread completed.");

print("\n=== ALL NATIVE SYSTEM CAPABILITIES VERIFIED SUCCESSFULLY ===");
