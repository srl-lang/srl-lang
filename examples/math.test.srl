// ============================================================================
// SRL Unit Test Suite - Math Module (examples/math.test.srl)
// ============================================================================

import("std/testing.srl");
import("std/math.srl");

test_suite("SRL Math & Vector Library Unit Tests");

// Test 1: Basic Math Functions
var c = clamp(42, 0, 100);
assert_eq(c, 42, "clamp(42, 0, 100) within range");

var c_max = clamp(150, 0, 100);
assert_eq(c_max, 100, "clamp(150, 0, 100) upper bound");

var l = lerp(0, 100, 0.5);
assert_eq(l, 50, "lerp(0, 100, 0.5)");

// Test 2: Vector Operations
var v1 = vec2(3, 4);
assert_eq(vec2_length(v1), 5, "vec2_length(3, 4) == 5");

var v2 = vec2(1, 2);
var v_sum = vec2_add(v1, v2);
assert_eq(map_get(v_sum, "x"), 4, "vec2_add x coordinate");
assert_eq(map_get(v_sum, "y"), 6, "vec2_add y coordinate");

// Print Final Summary
test_summary();
