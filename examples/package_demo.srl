// ============================================================================
// SRL Package & Standard Libraries Demo (examples/package_demo.srl)
// ============================================================================

import("std/math.srl");
import("std/env.srl");
import("std/http.srl");

print("========================================================");
print(" SRL PACKAGE & STANDARD LIBRARIES DEMO");
print("========================================================");

// 1. Math Module Verification
print("\n--- 1. Math & Vector Operations ---");
var v1 = vec2(3, 4);
var v2 = vec2(1, 2);
var v_sum = vec2_add(v1, v2);
var len = vec2_length(v1);

print("Vector 1       : (" + to_string(map_get(v1, "x")) + ", " + to_string(map_get(v1, "y")) + ")");
print("Vector 1 Length: " + to_string(len));
print("Vector Sum     : (" + to_string(map_get(v_sum, "x")) + ", " + to_string(map_get(v_sum, "y")) + ")");

var clamped = clamp(150, 0, 100);
print("Clamped Value  : " + to_string(clamped));

// 2. System & Env Verification
print("\n--- 2. System & Environment ---");
print("Current OS     : " + to_string(env_os()));
print("Working Dir    : " + to_string(env_pwd()));

print("\nDemo executed successfully!");
