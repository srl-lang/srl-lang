{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SRL",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#builtins" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.srl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.srl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.srl",
          "match": "\\b(if|else|while|for|in|match|case|default|return|import)\\b"
        },
        {
          "name": "storage.type.srl",
          "match": "\\b(fn|var|struct|const|enum)\\b"
        },
        {
          "name": "constant.language.srl",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.srl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.srl",
              "match": "\\\\."
            },
            {
              "name": "punctuation.definition.template-expression.srl",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#keywords" },
                { "include": "#functions" },
                { "include": "#operators" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.srl",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.srl",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.srl",
          "match": "\\b(print|to_string|to_number|arr_new|arr_len|arr_push|arr_pop|arr_get|arr_set|map_new|map_get|map_set|map_keys|is_map|is_array|str_len|str_sub|str_upper|str_lower|setmetatable|getmetatable|c_open|c_call|c_malloc|c_free|dsp_sine|dsp_fft|dsp_ifft|dsp_plot|qt_window|qt_exec|sys_exec|sys_read_file|sys_write_file)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.srl",
          "match": "(\\+|\\-|\\*|/|%|=|==|!=|<|>|<=|>=|=>|->|&&|\\|\\||\\.)"
        }
      ]
    }
  },
  "scopeName": "source.srl"
}
